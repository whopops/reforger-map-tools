{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/whopops/reforger-map-tools/schema/buildings.schema.json",
  "title": "Building export",
  "description": "One JSON file produced by py/buildings_to_json.py from a finished Workbench export. samples/buildings.sample.json is this schema with zero buildings. Do not invent rows; a real file is written only after Workbench has exported every tile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["buildings"],
  "properties": {
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prefab", "position", "yaw", "bounds", "enterable", "floors", "entrances"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable id from the building origin in centimetres: x_y_z."
          },
          "prefab": { "type": "string" },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "number" },
            "description": "Origin in metres, x east, y up, z north."
          },
          "yaw": {
            "type": "number",
            "description": "Degrees clockwise from north."
          },
          "bounds": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
              "max": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
            }
          },
          "enterable": {
            "type": "integer",
            "enum": [0, 1],
            "description": "1 only for a door, hatch, ladder, or a floor at least 2 m above the lowest floor cluster. Gaps alone do not set this."
          },
          "floors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["y", "samples"],
              "properties": {
                "y": { "type": "number", "description": "Cluster height in metres." },
                "samples": { "type": "integer", "minimum": 3 }
              }
            }
          },
          "entrances": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "position", "class"],
              "properties": {
                "kind": { "type": "string", "enum": ["door", "sliding-door", "hatch", "ladder", "gap"] },
                "position": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
                "class": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
